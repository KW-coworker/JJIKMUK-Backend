# Copy this file to backend/application-local.properties and enter local values.
# The real file is Git-ignored and is not packaged into the application JAR.
# Point this URL to the restored MySQL database on the new server.
spring.datasource.url=jdbc:mysql://localhost:3306/jjikmuk?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&rewriteBatchedStatements=true
spring.datasource.username=your-db-user
spring.datasource.password=your-db-password
jwt.secret=replace-with-a-long-random-secret
spring.mail.username=your-mail-account
spring.mail.password=your-mail-app-password
